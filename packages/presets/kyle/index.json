{
  "name": "kyle",
  "version": "1.0.0",
  "description": "Kyle's personalized preset with strict quality enforcement and architecture protection",

  "permissions": {
    "allow": [
      "Read(**)",
      "Write(**/*.{ts,tsx,js,jsx,json,md,css,scss,less})",
      "Edit(**)",
      "MultiEdit(**)",
      "Bash(pnpm *)",
      "Bash(npm run *)",
      "Bash(npm test*)",
      "Bash(yarn *)",
      "Bash(git *)",
      "Bash(tsc *)",
      "Bash(vitest *)",
      "Bash(jest *)",
      "Bash(eslint *)",
      "Grep(**)",
      "Glob(**)",
      "TodoWrite",
      "Task",
      "NotebookEdit",
      "WebFetch",
      "WebSearch"
    ],
    "deny": [
      "Write(**/node_modules/**)",
      "Write(**/.git/**)",
      "Write(**/dist/**)",
      "Write(**/build/**)",
      "Write(**/coverage/**)",
      "Bash(rm -rf /)",
      "Bash(sudo *)",
      "Bash(npm publish)"
    ],
    "ask": [
      "Write(**/package.json)",
      "Write(**/package-lock.json)",
      "Write(**/yarn.lock)",
      "Write(**/pnpm-lock.yaml)",
      "Write(**/.github/**)",
      "Bash(npm install *)",
      "Bash(pnpm add *)",
      "Bash(yarn add *)",
      "Bash(rm -rf *)",
      "Bash(npx *)"
    ]
  },

  "env": {
    "NODE_ENV": "development",
    "REACT_APP_ENV": "development",
    "DEBUG": "false"
  },

  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node ./node_modules/@hugsy/preset-kyle/hooks/hook-runner.js quality-guard.js 10000",
            "timeout": 10000
          }
        ]
      },
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "node ./node_modules/@hugsy/preset-kyle/hooks/hook-runner.js architecture-check.js 10000",
            "timeout": 10000
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node ./node_modules/@hugsy/preset-kyle/hooks/hook-runner.js auto-validate.js 60000",
            "timeout": 60000
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node ./node_modules/@hugsy/preset-kyle/hooks/hook-runner.js intent-analyzer.js 5000",
            "timeout": 5000
          }
        ]
      }
    ]
  },

  "slashCommands": {
    "files": [
      "./commands/check-quality.md",
      "./commands/fix-types.md",
      "./commands/check-arch.md",
      "./commands/validate-all.md",
      "./commands/show-coverage.md"
    ]
  },

  "subagents": {
    "files": [
      "./agents/quality-enforcer.md",
      "./agents/architecture-guardian.md",
      "./agents/test-master.md"
    ]
  },

  "metadata": {
    "author": "Kyle",
    "created": "2024-01-01",
    "tags": ["quality", "typescript", "testing", "architecture"],
    "requirements": {
      "node": ">=16.0.0",
      "typescript": ">=4.5.0"
    }
  }
}
